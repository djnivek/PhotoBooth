{
  "openapi": "3.0.3",
  "info": {
    "title": "PhotoBooth API",
    "version": "0.8.0",
    "description": "Personal booth API. Direct medium square image edits, idempotent claims, private storage and first-party business metrics. No public analytics read API. Printing stays local. Optional read-only room projection has a distinct capability and only exposes released complete results."
  },
  "servers": [
    {
      "url": "https://frkckrvsdsiwivdfyjau.supabase.co/functions/v1/photobooth-api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Configuration only; no billable probe",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/booth/check": {
      "get": {
        "operationId": "checkBooth",
        "summary": "Verify booth credential and server key presence",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoothCheck"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Create or replay the same UUID and options",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionInput"
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/photos/{index}": {
      "post": {
        "operationId": "startEdit",
        "summary": "Start one edit from its optimized private input, falling back to the archived original for older clients",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {}
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        ]
      },
      "get": {
        "operationId": "pollEdit",
        "summary": "Poll the existing response without creating another generation",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          {
            "name": "transport",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "direct"
              ]
            },
            "description": "Store the provider JPEG directly as the gallery result; avoids re-encoding and booth reupload."
          }
        ]
      }
    },
    "/sessions/{id}/assets/{name}": {
      "put": {
        "operationId": "uploadAsset",
        "summary": "Immutable SHA-256 upload: JPEG <=10 MiB or ZIP <=50 MiB",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Digest"
                }
              }
            }
          },
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Digest"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^((photo|original|input)-[1-4]\\.jpg|sheet\\.jpg|archive\\.zip)$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/zip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/share": {
      "post": {
        "operationId": "publishShare",
        "summary": "Build archive beside Storage when missing, then publish the complete session; no booth ZIP upload required",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Share"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/downloads/resolve": {
      "post": {
        "operationId": "resolveShare",
        "summary": "Read available photographs and session state; never starts or polls a provider job",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assets"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareInput"
              }
            }
          }
        }
      }
    },
    "/styles": {
      "get": {
        "operationId": "getStyles",
        "summary": "Public display metadata only, no prompts or credentials",
        "security": [],
        "responses": {
          "200": {
            "description": "Ordered catalog for memory caching. No generation or storage writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StyleCatalog"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/gallery": {
      "post": {
        "operationId": "prepareGallery",
        "summary": "Create a stable read-only gallery before photographs are ready; never starts generation",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EarlyGallery"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/monitoring/booth": {
      "post": {
        "operationId": "recordBoothMetrics",
        "summary": "Authenticated durable booth measurements",
        "security": [
          {
            "boothKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "events"
                ],
                "properties": {
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "$ref": "#/components/schemas/BoothMetric"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Input acknowledged, including duplicate event IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid metric or private/unavailable asset"
          },
          "401": {
            "description": "Booth code required"
          },
          "404": {
            "description": "Unavailable or expired gallery"
          },
          "503": {
            "description": "Monitoring temporarily unavailable; retain the queue"
          }
        }
      }
    },
    "/downloads/events": {
      "post": {
        "operationId": "recordGuestCounters",
        "summary": "Capability-scoped first-party counters",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "events"
                ],
                "properties": {
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "$ref": "#/components/schemas/GuestMetric"
                    }
                  },
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Input acknowledged, including duplicate event IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid metric or private/unavailable asset"
          },
          "401": {
            "description": "Booth code required"
          },
          "404": {
            "description": "Unavailable or expired gallery"
          },
          "503": {
            "description": "Monitoring temporarily unavailable; retain the queue"
          }
        }
      }
    },
    "/viewer/settings": {
      "post": {
        "summary": "Enable or disable projection; hash a separate viewer capability",
        "operationId": "_viewer_settings_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "include_tests": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "token",
                  "enabled",
                  "include_tests"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only projection state or idempotent acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Capability or session unavailable"
          },
          "503": {
            "description": "Temporary outage"
          }
        }
      }
    },
    "/sessions/{session_id}/viewer": {
      "post": {
        "summary": "Release a session for projection after guest departure",
        "operationId": "_sessions_viewer_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "camera",
                      "fixture"
                    ]
                  }
                },
                "required": [
                  "source"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only projection state or idempotent acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Capability or session unavailable"
          },
          "503": {
            "description": "Temporary outage"
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/viewer/feed": {
      "post": {
        "summary": "List complete released sessions; no signed photo URLs",
        "operationId": "_viewer_feed_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "known": {
                    "type": "string"
                  }
                },
                "required": [
                  "token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only projection state or idempotent acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Capability or session unavailable"
          },
          "503": {
            "description": "Temporary outage"
          }
        },
        "security": []
      }
    },
    "/viewer/photos": {
      "post": {
        "summary": "Sign only eligible final photos for one session",
        "operationId": "_viewer_photos_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "session_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "token",
                  "session_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only projection state or idempotent acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Capability or session unavailable"
          },
          "503": {
            "description": "Temporary outage"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "boothKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random booth secret, NOT an OpenAI key or Supabase JWT."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "api_version": {
            "type": "string"
          },
          "production_ready": {
            "type": "boolean"
          },
          "session_api_enabled": {
            "type": "boolean"
          },
          "image_generation_enabled": {
            "type": "boolean"
          }
        }
      },
      "SessionInput": {
        "type": "object",
        "required": [
          "id",
          "photo_count",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "photo_count": {
            "type": "integer",
            "enum": [
              1,
              4
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "original",
              "surprise"
            ]
          },
          "style": {
            "type": "string",
            "default": "chef",
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "description": "Legacy single choice. A catalog id selects that theme for every pose; chef chooses distinct active themes when possible. Exclusive with styles. Choices and complete per-pose prompts are frozen at creation."
          },
          "styles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,47}$"
            },
            "description": "One choice for one photo; one to four choices for four photos. Every explicit choice is used, repeats are balanced and diagonal on the 2x2 sheet. chef is exclusive; mix is reserved. Order of choices has no significance. Exclusive with style."
          }
        },
        "not": {
          "required": [
            "style",
            "styles"
          ]
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "style": {
            "type": "string",
            "description": "Concrete theme id, mix for several themes, or original. Retained for older clients."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "shot_styles": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string"
            },
            "description": "Frozen concrete theme ids in capture order, one per transformed photo. Empty for original mode. Complete prompts remain private on the server."
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "starting",
              "running",
              "ready",
              "failed",
              "uncertain"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "asset_stored": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "ShareInput": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "used_original_fallback": {
            "type": "boolean"
          }
        }
      },
      "Share": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "download_url": {
            "type": "string",
            "format": "uri"
          },
          "gallery_url": {
            "type": "string",
            "format": "uri",
            "description": "Canonical guest gallery with read-only capability in URL fragment. Preferred QR target."
          }
        },
        "required": [
          "gallery_url",
          "download_url",
          "expires_at",
          "token"
        ]
      },
      "Assets": {
        "type": "object",
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "photo_count": {
            "type": "integer",
            "enum": [
              1,
              4
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "original",
              "surprise"
            ]
          },
          "used_original_fallback": {
            "type": "boolean"
          },
          "state": {
            "type": "string",
            "enum": [
              "processing",
              "ready",
              "failed",
              "delayed"
            ]
          },
          "style": {
            "type": "string"
          },
          "completed_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "required": [
          "expires_at",
          "assets",
          "photo_count",
          "mode",
          "used_original_fallback"
        ]
      },
      "Digest": {
        "type": "object",
        "required": [
          "sha256"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "BoothCheck": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "image_generation_enabled": {
            "type": "boolean"
          },
          "image_model": {
            "type": "string"
          },
          "image_quality": {
            "type": "string",
            "enum": [
              "medium"
            ]
          },
          "image_size": {
            "type": "string",
            "enum": [
              "1024x1024"
            ]
          },
          "generation_api": {
            "type": "string",
            "enum": [
              "images/edits"
            ]
          }
        }
      },
      "StyleCatalog": {
        "type": "object",
        "required": [
          "version",
          "styles"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "styles": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "description",
                "asset",
                "color",
                "phrases"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "maxLength": 48
                },
                "description": {
                  "type": "string",
                  "maxLength": 140
                },
                "asset": {
                  "type": "string",
                  "maxLength": 80
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "phrases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 120
                  }
                }
              }
            }
          }
        }
      },
      "EarlyGallery": {
        "type": "object",
        "required": [
          "gallery_url",
          "expires_at"
        ],
        "properties": {
          "gallery_url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BoothMetric": {
        "type": "object",
        "required": [
          "id",
          "session_id",
          "kind",
          "occurred_at",
          "mode",
          "photo_count",
          "requested_style",
          "source",
          "shot_index"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "mode": {
            "type": "string",
            "enum": [
              "original",
              "surprise"
            ]
          },
          "photo_count": {
            "type": "integer",
            "enum": [
              1,
              4
            ]
          },
          "requested_style": {
            "type": "string"
          },
          "style": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "type": "string",
            "enum": [
              "camera",
              "fixture"
            ]
          },
          "shot_index": {
            "type": "integer",
            "minimum": -1,
            "maximum": 3
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 900000,
            "nullable": true
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 52428800,
            "nullable": true
          },
          "asset": {
            "type": "string",
            "nullable": true
          },
          "outcome": {
            "type": "string",
            "nullable": true
          },
          "view_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GuestMetric": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "view_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "view_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "gallery_view",
              "image_view",
              "download_requested"
            ]
          },
          "asset": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
