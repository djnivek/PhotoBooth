{
  "openapi": "3.0.3",
  "info": {
    "title": "PhotoBooth API",
    "version": "0.3.0",
    "description": "Personal booth API. Server-only OpenAI key, background xhigh edits, one durable claim per pose, private storage. No paid automated tests. Printing is local."
  },
  "servers": [
    {
      "url": "https://frkckrvsdsiwivdfyjau.supabase.co/functions/v1/photobooth-api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Configuration only; no billable probe",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/booth/check": {
      "get": {
        "operationId": "checkBooth",
        "summary": "Verify booth credential and server key presence",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoothCheck"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Create or replay the same UUID and options",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionInput"
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/photos/{index}": {
      "post": {
        "operationId": "startEdit",
        "summary": "Start one edit of an already uploaded original; never retry an ambiguous claim",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {}
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        ]
      },
      "get": {
        "operationId": "pollEdit",
        "summary": "Poll the existing response without creating another generation",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        ]
      }
    },
    "/sessions/{id}/assets/{name}": {
      "put": {
        "operationId": "uploadAsset",
        "summary": "Immutable SHA-256 upload: JPEG <=10 MiB or ZIP <=50 MiB",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Digest"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Digest"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^((photo|original)-[1-4]\\.jpg|sheet\\.jpg|archive\\.zip)$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/zip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/share": {
      "post": {
        "operationId": "publishShare",
        "summary": "Require all final photos, originals for AI, sheet and archive",
        "security": [
          {
            "boothKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Share"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/downloads/resolve": {
      "post": {
        "operationId": "resolveShare",
        "summary": "Resolve one unexpired capability to signed assets",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assets"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; no provider secret or automatic paid retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareInput"
              }
            }
          }
        }
      }
    },
    "/styles": {
      "get": {
        "operationId": "getStyles",
        "summary": "Public display metadata only, no prompts or credentials",
        "security": [],
        "responses": {
          "200": {
            "description": "Ordered catalog for memory caching. No generation or storage writes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StyleCatalog"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "boothKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random booth secret, NOT an OpenAI key or Supabase JWT."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "api_version": {
            "type": "string"
          },
          "production_ready": {
            "type": "boolean"
          },
          "session_api_enabled": {
            "type": "boolean"
          },
          "image_generation_enabled": {
            "type": "boolean"
          }
        }
      },
      "SessionInput": {
        "type": "object",
        "required": [
          "id",
          "photo_count",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "photo_count": {
            "type": "integer",
            "enum": [
              1,
              4
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "original",
              "surprise"
            ]
          },
          "style": {
            "type": "string",
            "default": "chef",
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "description": "Catalog id, or chef for one random universe for the whole session. The choice and scene prompt are frozen at creation."
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "style": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "starting",
              "running",
              "ready",
              "failed",
              "uncertain"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "ShareInput": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "used_original_fallback": {
            "type": "boolean"
          }
        }
      },
      "Share": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "download_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Assets": {
        "type": "object",
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "Digest": {
        "type": "object",
        "required": [
          "sha256"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "BoothCheck": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "image_generation_enabled": {
            "type": "boolean"
          }
        }
      },
      "StyleCatalog": {
        "type": "object",
        "required": [
          "version",
          "styles"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "styles": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "description",
                "asset",
                "color",
                "phrases"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "maxLength": 48
                },
                "description": {
                  "type": "string",
                  "maxLength": 140
                },
                "asset": {
                  "type": "string",
                  "maxLength": 80
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "phrases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 120
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
