<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PhotoBooth.App.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#FBF5E8" />
      <Setter Property="Foreground" Value="#512831" />
      <Setter Property="FontFamily" Value="Segoe UI, Arial" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="ToggleButton.style-choice:pointerover /template/ ContentPresenter, ToggleButton.style-choice:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#DFD0BD" />
      <Setter Property="Foreground" Value="#512831" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ToggleButton.style-choice:checked:pointerover /template/ ContentPresenter, ToggleButton.style-choice:checked:pressed /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#512831" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="54" />
      <Setter Property="Padding" Value="22,12" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Background" Value="#E9DFD1" />
      <Setter Property="Foreground" Value="#512831" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#742C3F" />
      <Setter Property="Foreground" Value="#FFF8EC" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="70" />
      <Setter Property="FontSize" Value="25" />
    </Style>
    <Style Selector="Button.selected"><Setter Property="Background" Value="#D8E0C9" /><Setter Property="Foreground" Value="#35472C" /><Setter Property="BorderBrush" Value="#57654A" /><Setter Property="BorderThickness" Value="2" /></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#DFD0BD" /><Setter Property="Foreground" Value="#512831" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#8D3B4E" /><Setter Property="Foreground" Value="#FFF8EC" /></Style>
    <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="#742C3F" /><Setter Property="BorderThickness" Value="3" /></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="Button.style-choice"><Setter Property="Foreground" Value="#512831" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="ToggleButton.style-choice">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="#512831" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.style-choice:focus-visible /template/ ContentPresenter"><Setter Property="BorderBrush" Value="#742C3F" /><Setter Property="BorderThickness" Value="3" /></Style>
    <Style Selector="ToggleButton.style-choice:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="50" /><Setter Property="FontSize" Value="20" /></Style>
  </Application.Styles>
</Application>
